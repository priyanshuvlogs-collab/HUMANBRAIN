# Copy this file to .env.local and fill in the values.
# .env.local is never committed (it's in .gitignore).

# --- Supabase (Project Settings → API Keys) ---------------------------------
# For local development, `npm run db:start` prints these values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (starts with sb_publishable_). Safe for the browser: RLS protects your data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Claude (https://platform.claude.com → API keys) ------------------------
# Server-side only. Never prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-xxx
# Model used for reviews.
CLAUDE_MODEL=claude-sonnet-5-5
# How hard Claude thinks: low | medium | high | xhigh | max | off. "medium" balances quality and speed.
CLAUDE_EFFORT=medium

# --- Access -------------------------------------------------------------------
# Comma-separated emails allowed to log in. REQUIRED on Vercel (empty = nobody can log in there).
# Locally, empty = anyone with a login code can use the app.
ALLOWED_EMAILS=you@example.com

# --- Testing -----------------------------------------------------------------
# true = reviews return a recorded sample reply instead of calling Claude (free; for trying the UI).
# Ignored on the live Vercel site.
OFFER_BRAIN_MOCK_AI=false
